{
  "name": "ik-crm",
  "version": "2.0.0",
  "description": "IK CRM MVP: pipeline, relationships and contracts for Insight Kitchen",
  "scripts": {
    "dev": "node scripts/build.mjs --watch --no-minify & node scripts/serve.mjs dist",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "check:brand": "node scripts/check-brand.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:stress": "STRESS_SCALE=5 vitest run tests/unit/performance.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run check:brand && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
